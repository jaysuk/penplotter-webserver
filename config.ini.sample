[telegram]
telegram_token =
telegram_chatid =

[tasmota]
tasmota_enable = false
tasmota_ip = 192.168.1.101
# Seconds to wait for the plotter to start up before sending, and to finish drawing before it is switched off
tasmota_on_delay = 2
tasmota_off_delay = 30

# Which messages to send (to Telegram, the webhook and MQTT). All can be changed in the web page.
[notifications]
notify_start = true
notify_finish = true
notify_error = true
notify_pen_change = true
# A message every this many percent (0 = never)
notify_progress_every = 0
# A newer version of the web plotter is available (also controlled by [updates] update_check)
notify_update = true
# Optional: a JSON POST for every message, and an MQTT broker (published to <topic>/<event>)
webhook_url =
mqtt_host =
mqtt_port = 1883
mqtt_topic = webplotter
mqtt_username =
mqtt_password =

[timelapse]
timelapse_enable = false
timelapse_auto_start = true
timelapse_preview = false
timelapse_source = url
timelapse_url =
timelapse_interval = 10
timelapse_fps = 25
timelapse_tail = 10
timelapse_keep_frames = false

[buttons]
buttons_enable = false
button_start_action = start
button_stop_action = stop

# Look on GitHub about once a day for a newer version (the VERSION file of the branch this was installed from)
[updates]
update_check = true

[plotter]
name = My Plotter
port = /dev/ttyAMA0
device = hp7475a
baudrate = 9600
flowcontrol = CTS/RTS

# Optional: require a login (HTTP basic auth) by adding an [auth] section.
# Anyone who can reach port 5000 can otherwise reboot the Pi and start plots.
# [auth]
# username = admin
# password = change-me
